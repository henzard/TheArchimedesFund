---
// Posts to Henzard's own personal-os server, so the subscriber list lives
// on infrastructure he controls rather than with a third-party newsletter
// provider. No JavaScript and no CORS: a form post is a navigation, and the
// server answers with a 303 back to /subscribed/.
import { SUBSCRIBE_ENDPOINT } from '../site.js';

const endpoint = SUBSCRIBE_ENDPOINT;

// Which page rendered the form, for the server's own throttle/analysis -
// not user-facing.
const source = Astro.url.pathname;
---
<form action={endpoint} method="post" class="subscribe">
  <label for="bd-email">Get new essays by email</label>
  <input id="bd-email" type="email" name="email" required autocomplete="email" />
  {/*
    Honeypot: a field named "website" that a human never sees or reaches,
    but a naive bot filling every field will. Hidden with CSS (not
    type="hidden", which unsophisticated bots skip) and pulled out of
    both the visual layout and the tab order and accessibility tree, so
    it is invisible and unreachable for sighted users, screen-reader
    users and keyboard users alike - not just visually hidden.
  */}
  <div class="hp-field" aria-hidden="true">
    <label for="bd-website">Website</label>
    <input id="bd-website" type="text" name="website" tabindex="-1" autocomplete="off" />
  </div>
  <input type="hidden" name="source" value={source} />
  <button type="submit">Subscribe</button>
  <p class="meta">New essays only. No tracking, and nothing shared with anyone.</p>
</form>

<p class="meta subscribe-alt">
  Prefer a reader? <a href="/rss.xml">Follow over RSS</a> instead.
</p>

<style>
  .subscribe {
    display: grid;
    gap: var(--space-sm);
    max-width: var(--measure);
  }
  .subscribe label {
    font-family: var(--font-mono);
    font-size: var(--step-meta);
    color: var(--slate);
  }
  .subscribe input {
    font: inherit;
    padding: var(--space-sm);
    border: 1px solid var(--hairline);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
  }
  .subscribe input:focus-visible {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }
  .subscribe button {
    justify-self: start;
    font: inherit;
    padding: var(--space-sm) var(--space-lg);
    border: none;
    border-radius: var(--radius-sm);
    background: var(--accent);
    color: var(--on-accent);
    cursor: pointer;
  }
  .subscribe button:hover {
    text-decoration: underline;
  }
  .subscribe .meta {
    margin: 0;
  }

  /* Honeypot: hidden with CSS, not type="hidden" - a naive bot script that
     only skips type="hidden" inputs still fills this one in, which is the
     point. Combined with aria-hidden + tabindex="-1" in the markup, no
     real visitor (sighted, screen-reader or keyboard) can reach or see it. */
  .hp-field {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
