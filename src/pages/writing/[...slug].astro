---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const essays = await getCollection('essays', ({ data }) => import.meta.env.PROD ? !data.draft : true);
  return essays.map((essay) => ({ params: { slug: essay.id }, props: { essay } }));
}

const { essay } = Astro.props;
const { Content } = await render(essay);
---
<Base title={`${essay.data.title} — Henzard Kruger`} description={essay.data.description}>
  <article>
    <h1>{essay.data.title}</h1>
    <time datetime={essay.data.date.toISOString()}>
      {essay.data.date.toISOString().slice(0, 10)}
    </time>
    <Content />
  </article>
</Base>
