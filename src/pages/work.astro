---
import Base from '../layouts/Base.astro';
import projects from '../data/work.json';

// Curated, static data: eight projects, described from their own READMEs.
// Nothing on this page is fetched at build time or in the browser.
const byName = new Map(projects.map((p) => [p.name, p]));
function pick(name) {
  const found = byName.get(name);
  if (!found) throw new Error(`work.json has no project named "${name}"`);
  return found;
}

// Grouping is presentation, decided here; the data itself stays flat.
// The feature and its companion are the two entries from the same
// hackathon: one placed second, one did not place. They read together.
const groups = [
  {
    label: 'Agentic and AI systems',
    feature: pick('The AI Scientist'),
    companion: pick('AmplifyAI'),
    rest: [
      pick('AI-first engineering workspace'),
      pick('BibleStudy'),
      pick('TruthAISwarm'),
    ],
  },
  {
    label: 'Teaching and contribution',
    feature: null,
    companion: null,
    rest: [pick('AITrainingGuide'), pick('OpenClaw')],
  },
  {
    label: 'Home Assistant integrations',
    feature: null,
    companion: null,
    rest: [pick('NASA Sky Hub'), pick('Easy Equities for Home Assistant')],
  },
  {
    label: 'Practical tools',
    feature: null,
    companion: null,
    rest: [pick('AccountingV2'), pick('Weight certificate converter')],
  },
];

const placed = groups.flatMap((g) => [
  ...(g.feature ? [g.feature] : []),
  ...(g.companion ? [g.companion] : []),
  ...g.rest,
]);
if (placed.length !== projects.length) {
  throw new Error('work.astro does not place every project in work.json');
}

// Areas of work, taken from brand positioning rather than written fresh here.
const areas = [
  {
    term: 'AI and agentic systems',
    note: 'AI matters when it changes how real work gets done: architecture, operating models and engineering practice rather than spectacle.',
  },
  {
    term: 'Developer productivity and AI-assisted engineering',
    note: 'How AI-assisted development changes the day-to-day work of building software, with the workflow and quality gates to match.',
  },
  {
    term: 'Enterprise modernisation',
    note: 'Modernisation is not a technology swap. It is a system of constraints, incentives, legacy choices, people, architecture and execution.',
  },
  {
    term: 'Systems thinking',
    note: 'Making dependencies and trade-offs visible, preferring models that explain why something works and where it breaks.',
  },
  {
    term: 'Mentoring',
    note: 'Knowledge should compound through people: explaining difficult things without dumbing them down.',
  },
];
---
<Base
  title="Work - Henzard Kruger"
  description="Eight selected projects, described by hand, with a note on the work that is not public."
>
  <section class="section intro">
    <div class="shell intro-grid">
      <div>
        <h1>Selected work</h1>
        <p class="lede">
          Eleven entries, chosen and described by hand. Each description is
          condensed from the project's own README, and public repositories
          link straight to the source.
        </p>
      </div>
      <p class="meta source-note">11 entries, curated</p>
    </div>
  </section>

  <section class="section work-section" aria-labelledby="selected-heading">
    <h2 id="selected-heading" class="visually-hidden">The projects</h2>
    <div class="shell">
      {groups.map((group) => (
        <div class="group">
          <p class="meta group-label">{group.label}</p>
          <div class="group-body">
            {group.feature && (
              <div class="pair">
                <article class="entry feature">
                  <h3 class="feature-name">
                    <a href={group.feature.url}>{group.feature.name}</a>
                  </h3>
                  <p class="feature-desc">{group.feature.what}</p>
                  <p class="meta tags">{group.feature.tags.join(' / ')}</p>
                </article>
                {group.companion && (
                  <article class="entry companion">
                    <h3 class="entry-name">{group.companion.name}</h3>
                    <p class="entry-desc">{group.companion.what}</p>
                    <p class="meta tags">
                      {group.companion.tags.join(' / ')}
                      {!group.companion.url && <span class="badge">private repository</span>}
                    </p>
                  </article>
                )}
              </div>
            )}
            <div class={group.rest.length === 3 ? 'row row-3' : 'row row-2'}>
              {group.rest.map((item) => (
                <article class="entry">
                  <h3 class="entry-name">
                    {item.url ? <a href={item.url}>{item.name}</a> : item.name}
                  </h3>
                  <p class="entry-desc">{item.what}</p>
                  <p class="meta tags">
                    {item.tags.join(' / ')}
                    {item.role === 'contributor' && <span class="badge">contribution</span>}
                    {!item.url && <span class="badge">private repository</span>}
                  </p>
                </article>
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>

  <section class="section areas-section" aria-labelledby="areas-heading">
    <div class="shell areas-grid">
      <div class="areas-head">
        <h2 id="areas-heading">What I work on</h2>
        <p class="areas-lede">
          Practical systems thinking for leaders and builders navigating
          AI-driven change.
        </p>
      </div>
      <dl class="areas-list">
        {areas.map((area, i) => (
          <div class={i === 0 ? 'area area-wide' : 'area'}>
            <dt>{area.term}</dt>
            <dd>{area.note}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <section class="section note-section" aria-labelledby="note-heading">
    <div class="shell">
      <h2 id="note-heading">What is not here</h2>
      <p class="note-copy">
        Most of my work lives in private repositories, so the public projects
        above are a partial view. Client and commercial work is not shown.
      </p>
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 2rem + 4vw, 5rem) var(--space-xl); }
  .intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 8fr) minmax(0, 3fr);
    gap: var(--space-xl);
    align-items: end;
  }
  .intro h1 { margin-bottom: var(--space-md); }
  .intro .lede { margin: 0; max-width: 52ch; }
  .source-note { margin: 0; text-align: right; }

  .visually-hidden {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* Selected work: side-labelled groups, one featured entry, no card soup */
  .work-section { padding-block-start: 0; }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 9fr);
    gap: var(--space-lg) var(--space-2xl);
    align-items: start;
    border-top: 1px solid var(--hairline);
    padding-block: var(--space-xl) var(--space-2xl);
  }
  .group-label { margin: 0; letter-spacing: 0.04em; text-transform: uppercase; }

  .entry h3 { margin: 0 0 var(--space-sm); }
  .entry a { color: var(--text); text-decoration: none; }
  .entry a:hover { color: var(--link); text-decoration: underline; }

  /* The two hackathon entries sit as one pair: the featured result and
     the one that did not place, side by side, told the same way. */
  .pair {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: start;
    margin-bottom: var(--space-xl);
  }
  .companion {
    border-inline-start: 2px solid var(--hairline);
    padding-inline-start: var(--space-lg);
  }

  .badge {
    display: inline-block;
    margin-inline-start: var(--space-md);
    color: var(--link);
  }

  .feature { max-width: var(--measure); }
  .feature-name { font-size: var(--step-h2); letter-spacing: -0.015em; }
  .feature-desc {
    margin: 0 0 var(--space-sm);
    font-size: var(--step-body-lg);
    line-height: 1.6;
    color: var(--text-2);
  }

  .row { display: grid; gap: var(--space-xl); }
  .row-3 { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .row-2 { grid-template-columns: minmax(0, 6fr) minmax(0, 5fr); }
  .pair + .row-3 .entry {
    border-top: 1px solid var(--hairline-soft);
    padding-top: var(--space-lg);
  }
  .entry-name { font-size: var(--step-h3); }
  .entry-desc { margin: 0 0 var(--space-sm); color: var(--text-2); line-height: 1.55; }
  .tags { margin: 0; }

  /* What I work on: surface band, one wide item breaking the pair grid */
  .areas-section { background: var(--surface); }
  .areas-grid {
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .areas-head h2 { margin-bottom: var(--space-sm); }
  .areas-lede { margin: 0; color: var(--text-2); max-width: 32ch; }
  .areas-list {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-xl) var(--space-2xl);
  }
  .area-wide { grid-column: 1 / -1; max-width: var(--measure); }
  .area dt { font-weight: 600; margin-bottom: var(--space-xs); }
  .area dd { margin: 0; color: var(--text-2); line-height: 1.55; }
  .area-wide dd { font-size: var(--step-body-lg); line-height: 1.6; }

  /* The honest note: short, plain, no decoration beyond a hairline */
  .note-section { border-top: 1px solid var(--hairline-soft); }
  .note-copy { margin: 0; max-width: var(--measure); color: var(--text-2); }

  @media (max-width: 900px) {
    .intro-grid { grid-template-columns: 1fr; gap: var(--space-md); align-items: start; }
    .source-note { text-align: left; }
    .group { grid-template-columns: 1fr; gap: var(--space-md); }
    .pair { grid-template-columns: 1fr; gap: var(--space-xl); }
    .companion { border-inline-start: 0; padding-inline-start: 0; }
    .row-3 { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .areas-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
  }
  @media (max-width: 560px) {
    .row-3, .row-2, .areas-list { grid-template-columns: 1fr; }
    .area-wide { grid-column: auto; }
  }
</style>
