---
import Base from '../layouts/Base.astro';
import EmailCapture from '../components/EmailCapture.astro';
---
<Base
  title="Contact - Henzard Kruger"
  description="Get in touch, or invite Henzard Kruger to speak on AI, agentic systems and enterprise transformation."
>
  <section class="section intro" aria-labelledby="contact-heading">
    <div class="shell contact-grid">
      <div>
        <h1 id="contact-heading">Get in touch</h1>
        <p class="lede">
          Tell me what you are working on and where it is getting stuck.
          That is usually more useful to me than a general introduction.
        </p>
        <p class="cta">
          <a class="btn" href="mailto:henzardkruger@gmail.com">Email me</a>
          <span class="meta">henzardkruger@gmail.com</span>
        </p>
      </div>
      <section class="speaking" aria-labelledby="speaking-heading">
        <h2 id="speaking-heading">Speaking</h2>
        <p>
          I would speak on any of the topics I write about here: AI and
          agentic systems that hold up outside a demo, enterprise
          transformation as a systems problem rather than a technology swap,
          systems thinking for people making high-consequence technology
          decisions, and mentoring engineers through complex technical
          change. If one of those fits your event, email me and we can talk
          about the specifics.
        </p>
      </section>
    </div>
  </section>

  <section class="subscribe" aria-labelledby="subscribe-heading">
    <div class="shell">
      <h2 id="subscribe-heading">Stay in touch</h2>
      <EmailCapture />
    </div>
  </section>
</Base>

<style>
  .intro { padding-block: clamp(3rem, 2rem + 4vw, 5.5rem) var(--section-pad); }
  .contact-grid {
    display: grid;
    grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
    gap: var(--space-2xl);
    align-items: start;
  }
  .intro h1 { margin-bottom: var(--space-md); }
  .intro .lede { margin: 0 0 var(--space-xl); max-width: 38ch; }
  .cta { margin: 0; display: flex; align-items: center; gap: var(--space-md); flex-wrap: wrap; }

  .speaking {
    border-inline-start: 1px solid var(--hairline);
    padding-inline-start: var(--space-2xl);
  }
  .speaking h2 { font-size: var(--step-h3); margin-bottom: var(--space-sm); }
  .speaking p { margin: 0; color: var(--text-2); max-width: 48ch; }

  .subscribe { background: var(--surface); padding-block: var(--space-2xl); }
  .subscribe h2 { font-size: var(--step-h2); margin-bottom: var(--space-md); }

  @media (max-width: 860px) {
    .contact-grid { grid-template-columns: 1fr; gap: var(--space-xl); }
    .speaking { border-inline-start: none; padding-inline-start: 0; border-top: 1px solid var(--hairline); padding-top: var(--space-xl); }
  }
</style>
